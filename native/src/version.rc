// Version resource for chocobar.exe. Numbers come from version.h so the file
// properties, the startup log line and the release tag all agree.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CB_VER_MAJOR,CB_VER_MINOR,CB_VER_PATCH,0
PRODUCTVERSION  CB_VER_MAJOR,CB_VER_MINOR,CB_VER_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName",      "mnsky"
            VALUE "FileDescription",  "Chocobar status bar"
            VALUE "FileVersion",      CB_VER_STR
            VALUE "InternalName",     "chocobar"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "chocobar.exe"
            VALUE "ProductName",      "Chocobar"
            VALUE "ProductVersion",   CB_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
